# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ─────────────────────────────────────────────
# Virtual environments
# ─────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ─────────────────────────────────────────────
# Jupyter notebooks (not used in this project)
# ─────────────────────────────────────────────
*.ipynb
.ipynb_checkpoints/

# ─────────────────────────────────────────────
# Data — raw CSVs are never committed
# (downloaded with `brent data download`)
# ─────────────────────────────────────────────
data/raw/
data/*.csv
data/*.xlsx
data/*.parquet
data/*.json

# ─────────────────────────────────────────────
# Trained models and checkpoints
# ─────────────────────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.pth
*.npy
*.npz

# ─────────────────────────────────────────────
# Experiment tracking
# ─────────────────────────────────────────────
mlruns/

# ─────────────────────────────────────────────
# Tooling caches
# ─────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
junit.xml
htmlcov/

# ─────────────────────────────────────────────
# IDEs
# ─────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ─────────────────────────────────────────────
# Operating system
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# Logs and temporary files
# ─────────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.swp

# ─────────────────────────────────────────────
# Distribution / build
# ─────────────────────────────────────────────
dist/
build/
*.egg-info/

# ─────────────────────────────────────────────
# Generated results (re-created on every training run)
# ─────────────────────────────────────────────
results/

# ─────────────────────────────────────────────
# Terraform (state lives in GCS; tfvars may hold project ids and account emails)
# ─────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
!infra/tests/*.tfvars
*_override.tf
crash.log
crash.*.log
.terraformrc
terraform.rc
.tflint.d/

# MkDocs build output
/site/
